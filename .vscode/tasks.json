{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Echo Island: Full simulation audit (start Rasa first)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Test-Simulation.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Full adventure with push-to-talk (start Rasa first)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1", "-Microphone", "-Condition", "humour"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Test robot output bridge - silent simulator (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1", "-BridgeSimulator"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Rehearse full Reachy adventure - humour (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1", "-CompanionPreview", "-Condition", "humour"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Rehearse full Reachy adventure - control (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1", "-CompanionPreview", "-Condition", "control"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Start Rasa controls (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Start-Rasa.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Type companion control requests (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Control-Companion.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Play with external mock controller (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Check controller integration (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Play-Controller.ps1", "-Test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Play on Mac",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/Launch-Mac.sh", "play"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Open Godot Editor on Mac",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/Launch-Mac.sh", "editor"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Echo Island: Run Game Checks on Mac",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/Launch-Mac.sh", "test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
